<?xml version="1.0"?>
<sdf version="1.7">
  <!--
    Compact single-storey indoor navigation world.
    Footprint: 12.0 m x 9.0 m; recommended spawn: (0, 0, 0.05).
  -->
  <world name="indoor_flat">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light name="indoor_fill" type="point">
      <pose>0 0 3.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.7 0.72 0.75 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>18</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <model name="indoor_flat_structure">
      <static>true</static>
      <link name="structure_link">
        <!-- Floor: top surface is z = 0.0. -->
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12 9 0.1</size></box></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12 9 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <!-- 2.2 m high perimeter walls. -->
        <collision name="wall_west_collision">
          <pose>-6.06 0 1.1 0 0 0</pose>
          <geometry><box><size>0.12 9.12 2.2</size></box></geometry>
        </collision>
        <visual name="wall_west_visual">
          <pose>-6.06 0 1.1 0 0 0</pose>
          <geometry><box><size>0.12 9.12 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name="wall_east_collision">
          <pose>6.06 0 1.1 0 0 0</pose>
          <geometry><box><size>0.12 9.12 2.2</size></box></geometry>
        </collision>
        <visual name="wall_east_visual">
          <pose>6.06 0 1.1 0 0 0</pose>
          <geometry><box><size>0.12 9.12 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name="wall_south_collision">
          <pose>0 -4.56 1.1 0 0 0</pose>
          <geometry><box><size>12.12 0.12 2.2</size></box></geometry>
        </collision>
        <visual name="wall_south_visual">
          <pose>0 -4.56 1.1 0 0 0</pose>
          <geometry><box><size>12.12 0.12 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name="wall_north_collision">
          <pose>0 4.56 1.1 0 0 0</pose>
          <geometry><box><size>12.12 0.12 2.2</size></box></geometry>
        </collision>
        <visual name="wall_north_visual">
          <pose>0 4.56 1.1 0 0 0</pose>
          <geometry><box><size>12.12 0.12 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>

        <!-- Interior partitions. Door gaps are 1.6-1.8 m wide. -->
        <collision name="partition_west_south_collision">
          <pose>-2.5 -2.65 1.1 0 0 0</pose>
          <geometry><box><size>0.12 3.7 2.2</size></box></geometry>
        </collision>
        <visual name="partition_west_south_visual">
          <pose>-2.5 -2.65 1.1 0 0 0</pose>
          <geometry><box><size>0.12 3.7 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
        <collision name="partition_west_north_collision">
          <pose>-2.5 2.75 1.1 0 0 0</pose>
          <geometry><box><size>0.12 3.5 2.2</size></box></geometry>
        </collision>
        <visual name="partition_west_north_visual">
          <pose>-2.5 2.75 1.1 0 0 0</pose>
          <geometry><box><size>0.12 3.5 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>

        <!-- East end x = 0.74; 1.20 m clear to the short wall's west face x = 1.94. -->
        <collision name="partition_north_collision">
          <pose>-0.88 1.55 1.1 0 0 0</pose>
          <geometry><box><size>3.24 0.12 2.2</size></box></geometry>
        </collision>
        <visual name="partition_north_visual">
          <pose>-0.88 1.55 1.1 0 0 0</pose>
          <geometry><box><size>3.24 0.12 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>

        <collision name="partition_east_collision">
          <pose>3.9 -1.45 1.1 0 0 0</pose>
          <geometry><box><size>4.2 0.12 2.2</size></box></geometry>
        </collision>
        <visual name="partition_east_visual">
          <pose>3.9 -1.45 1.1 0 0 0</pose>
          <geometry><box><size>4.2 0.12 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>

        <collision name="partition_short_collision">
          <pose>2.0 3.15 1.1 0 0 0</pose>
          <geometry><box><size>0.12 2.7 2.2</size></box></geometry>
        </collision>
        <visual name="partition_short_visual">
          <pose>2.0 3.15 1.1 0 0 0</pose>
          <geometry><box><size>0.12 2.7 2.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Three sparse obstacles from ~/.gazebo/models. -->
    <include>
      <uri>model://bookshelf</uri>
      <name>flat_bookshelf</name>
      <pose>-4.55 2.15 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://cafe_table</uri>
      <name>flat_cafe_table</name>
      <pose>3.65 2.55 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://construction_barrel</uri>
      <name>flat_barrel</name>
      <pose>4.65 -3.0 0 0 0 0</pose>
    </include>

    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>11 -13 12 0 0.55 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
