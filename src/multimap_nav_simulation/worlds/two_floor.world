<?xml version="1.0"?>
<sdf version="1.7">
  <!--
    Compact two-storey indoor navigation world.

    Floor heights: 0.0 m and 1.0 m.
    Ground-floor footprint: 13.0 m x 11.0 m.
    The compact 7.7 m x 5.0 m upper deck occupies the south side only,
    leaving the default spawn at (0, 0) uncovered and easy to observe.
    Ramp 1: 0.0 -> 0.5 m; ramp 2: 0.5 -> 1.0 m.
    Each ramp has 3.8 m horizontal run (about 7.5 degrees) and 1.25 m
    clear width. The 2.9 m x 1.4 m middle landing supports a U-turn.
    Recommended ground-floor spawn: (0, 0, 0.05).
  -->
  <world name="two_floor">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.48 0.48 0.5 1</ambient>
      <background>0.73 0.77 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <light name="lower_floor_fill" type="point">
      <pose>-2.5 0 0.7 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.55 0.58 0.62 1</diffuse>
      <attenuation><range>12</range><constant>0.5</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="upper_floor_fill" type="point">
      <pose>-2.5 -3.5 2.4 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.65 0.67 0.7 1</diffuse>
      <attenuation><range>14</range><constant>0.5</constant><linear>0.07</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <model name="two_floor_structure">
      <static>true</static>
      <link name="structure_link">
        <!-- Ground floor, top surface z = 0.0. -->
        <collision name="ground_floor_collision">
          <pose>0 -0.5 -0.05 0 0 0</pose>
          <geometry><box><size>13 11 0.1</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_floor_visual">
          <pose>0 -0.5 -0.05 0 0 0</pose>
          <geometry><box><size>13 11 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>

        <!-- Full-height outside walls; the east half stays open above the ramps. -->
        <collision name="outer_west_collision">
          <pose>-6.56 -0.5 1.3 0 0 0</pose>
          <geometry><box><size>0.12 11.12 2.6</size></box></geometry>
        </collision>
        <visual name="outer_west_visual">
          <pose>-6.56 -0.5 1.3 0 0 0</pose>
          <geometry><box><size>0.12 11.12 2.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name="outer_east_collision">
          <pose>6.56 -0.5 1.3 0 0 0</pose>
          <geometry><box><size>0.12 11.12 2.6</size></box></geometry>
        </collision>
        <visual name="outer_east_visual">
          <pose>6.56 -0.5 1.3 0 0 0</pose>
          <geometry><box><size>0.12 11.12 2.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name="outer_south_collision">
          <pose>0 -6.06 1.3 0 0 0</pose>
          <geometry><box><size>13.12 0.12 2.6</size></box></geometry>
        </collision>
        <visual name="outer_south_visual">
          <pose>0 -6.06 1.3 0 0 0</pose>
          <geometry><box><size>13.12 0.12 2.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <collision name="outer_north_collision">
          <pose>0 5.06 1.3 0 0 0</pose>
          <geometry><box><size>13.12 0.12 2.6</size></box></geometry>
        </collision>
        <visual name="outer_north_visual">
          <pose>0 5.06 1.3 0 0 0</pose>
          <geometry><box><size>13.12 0.12 2.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>

        <!-- Compact south-side upper deck: top z = 1.0, underside z = 0.88. -->
        <collision name="upper_floor_collision">
          <pose>-2.65 -3.5 0.94 0 0 0</pose>
          <geometry><box><size>7.7 5.0 0.12</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="upper_floor_visual">
          <pose>-2.65 -3.5 0.94 0 0 0</pose>
          <geometry><box><size>7.7 5.0 0.12</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>

        <!-- Upper landing joins ramp 2 to the upper deck. -->
        <collision name="upper_landing_collision">
          <pose>2.235 -4.85 0.95 0 0 0</pose>
          <geometry><box><size>2.37 2.20 0.1</size></box></geometry>
          <surface><friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction></surface>
        </collision>
        <visual name="upper_landing_visual">
          <pose>2.235 -4.85 0.95 0 0 0</pose>
          <geometry><box><size>2.37 2.20 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>

        <!--
          Ramp 1: +Y ascent, roll = +7.50 deg. Its low 0.30 m is buried
          under the ground floor, so the slope emerges without a wheel-catching
          vertical seam. The usable horizontal run remains 3.8 m.
        -->
        <collision name="ramp_1_collision">
          <pose>4.25 -2.0435 0.1807 0.1309 0 0</pose>
          <geometry><box><size>1.25 4.1354 0.1</size></box></geometry>
          <surface>
            <contact><ode><kp>1000000</kp><kd>100</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode></contact>
            <friction><ode><mu>8.0</mu><mu2>8.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ramp_1_visual">
          <pose>4.25 -2.0435 0.1807 0.1309 0 0</pose>
          <geometry><box><size>1.25 4.1354 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>

        <!--
          Ramp 2: -Y ascent. Its low 0.30 m is buried under the middle
          landing for the same seamless entry treatment.
        -->
        <collision name="ramp_2_collision">
          <pose>2.75 -1.7565 0.6807 -0.1309 0 0</pose>
          <geometry><box><size>1.25 4.1354 0.1</size></box></geometry>
          <surface>
            <contact><ode><kp>1000000</kp><kd>100</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode></contact>
            <friction><ode><mu>8.0</mu><mu2>8.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ramp_2_visual">
          <pose>2.75 -1.7565 0.6807 -0.1309 0 0</pose>
          <geometry><box><size>1.25 4.1354 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>

        <!-- Middle landing: top z = 0.5, enough room for a differential-drive U-turn. -->
        <collision name="middle_landing_collision">
          <pose>3.5 0.65 0.45 0 0 0</pose>
          <geometry><box><size>2.9 1.4 0.1</size></box></geometry>
          <surface><friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction></surface>
        </collision>
        <visual name="middle_landing_visual">
          <pose>3.5 0.65 0.45 0 0 0</pose>
          <geometry><box><size>2.9 1.4 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>

        <!-- Low ramp rails follow the two slopes and prevent wheel drop-off. -->
        <collision name="ramp_1_west_rail_collision">
          <pose>3.59 -2.066 0.4038 0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
        </collision>
        <visual name="ramp_1_west_rail_visual">
          <pose>3.59 -2.066 0.4038 0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="ramp_1_east_rail_collision">
          <pose>4.91 -2.066 0.4038 0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
        </collision>
        <visual name="ramp_1_east_rail_visual">
          <pose>4.91 -2.066 0.4038 0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="ramp_2_west_rail_collision">
          <pose>2.09 -1.734 0.9038 -0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
        </collision>
        <visual name="ramp_2_west_rail_visual">
          <pose>2.09 -1.734 0.9038 -0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="ramp_2_east_rail_collision">
          <pose>3.41 -1.734 0.9038 -0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
        </collision>
        <visual name="ramp_2_east_rail_visual">
          <pose>3.41 -1.734 0.9038 -0.1309 0 0</pose>
          <geometry><box><size>0.07 4.1354 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>

        <!-- Landing and upper-floor guard rails. -->
        <collision name="middle_north_rail_collision">
          <pose>3.5 1.35 0.675 0 0 0</pose>
          <geometry><box><size>2.97 0.07 0.35</size></box></geometry>
        </collision>
        <visual name="middle_north_rail_visual">
          <pose>3.5 1.35 0.675 0 0 0</pose>
          <geometry><box><size>2.97 0.07 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="middle_east_rail_collision">
          <pose>4.95 0.65 0.675 0 0 0</pose>
          <geometry><box><size>0.07 1.4 0.35</size></box></geometry>
        </collision>
        <visual name="middle_east_rail_visual">
          <pose>4.95 0.65 0.675 0 0 0</pose>
          <geometry><box><size>0.07 1.4 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="middle_west_rail_collision">
          <pose>2.05 0.65 0.675 0 0 0</pose>
          <geometry><box><size>0.07 1.4 0.35</size></box></geometry>
        </collision>
        <visual name="middle_west_rail_visual">
          <pose>2.05 0.65 0.675 0 0 0</pose>
          <geometry><box><size>0.07 1.4 0.35</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="upper_edge_rail_collision">
          <pose>1.235 -2.375 1.225 0 0 0</pose>
          <geometry><box><size>0.07 2.75 0.45</size></box></geometry>
        </collision>
        <visual name="upper_edge_rail_visual">
          <pose>1.235 -2.375 1.225 0 0 0</pose>
          <geometry><box><size>0.07 2.75 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="upper_north_edge_rail_collision">
          <pose>-2.65 -0.965 1.225 0 0 0</pose>
          <geometry><box><size>7.77 0.07 0.45</size></box></geometry>
        </collision>
        <visual name="upper_north_edge_rail_visual">
          <pose>-2.65 -0.965 1.225 0 0 0</pose>
          <geometry><box><size>7.77 0.07 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name="upper_landing_east_rail_collision">
          <pose>3.455 -4.85 1.225 0 0 0</pose>
          <geometry><box><size>0.07 2.27 0.45</size></box></geometry>
        </collision>
        <visual name="upper_landing_east_rail_visual">
          <pose>3.455 -4.85 1.225 0 0 0</pose>
          <geometry><box><size>0.07 2.27 0.45</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>

        <!-- Ground-floor partitions stop at the underside of the upper deck. -->
        <collision name="lower_partition_south_collision">
          <pose>-2.5 -3.0 0.44 0 0 0</pose>
          <geometry><box><size>0.12 4.0 0.88</size></box></geometry>
        </collision>
        <visual name="lower_partition_south_visual">
          <pose>-2.5 -3.0 0.44 0 0 0</pose>
          <geometry><box><size>0.12 4.0 0.88</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
        <collision name="lower_partition_north_collision">
          <pose>-2.5 3.0 0.44 0 0 0</pose>
          <geometry><box><size>0.12 4.0 0.88</size></box></geometry>
        </collision>
        <visual name="lower_partition_north_visual">
          <pose>-2.5 3.0 0.44 0 0 0</pose>
          <geometry><box><size>0.12 4.0 0.88</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
        <collision name="lower_partition_cross_collision">
          <pose>-0.65 1.5 0.44 0 0 0</pose>
          <geometry><box><size>3.7 0.12 0.88</size></box></geometry>
        </collision>
        <visual name="lower_partition_cross_visual">
          <pose>-0.65 1.5 0.44 0 0 0</pose>
          <geometry><box><size>3.7 0.12 0.88</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>

        <!-- Compact upper-floor room walls, kept entirely on the reduced deck. -->
        <collision name="upper_partition_south_collision">
          <pose>-2.5 -3.0 1.7 0 0 0</pose>
          <geometry><box><size>0.12 4.0 1.4</size></box></geometry>
        </collision>
        <visual name="upper_partition_south_visual">
          <pose>-2.5 -3.0 1.7 0 0 0</pose>
          <geometry><box><size>0.12 4.0 1.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
        <!-- East end stops at x = 0.2, leaving a 1.0 m doorway to the edge rail at x = 1.2. -->
        <collision name="upper_partition_cross_collision">
          <pose>-1.15 -2.5 1.7 0 0 0</pose>
          <geometry><box><size>2.7 0.12 1.4</size></box></geometry>
        </collision>
        <visual name="upper_partition_cross_visual">
          <pose>-1.15 -2.5 1.7 0 0 0</pose>
          <geometry><box><size>2.7 0.12 1.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Sparse obstacles: one below the deck, one in the open lower area, one upstairs. -->
    <include>
      <uri>model://cafe_table</uri>
      <name>lower_cafe_table</name>
      <pose>-4.25 2.7 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://construction_barrel</uri>
      <name>lower_barrel</name>
      <pose>5.55 2.6 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://bookshelf</uri>
      <name>upper_bookshelf</name>
      <pose>-4.45 -2.65 1.0 0 0 1.5708</pose>
    </include>

    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>14 16 12 0 0.52 -2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
