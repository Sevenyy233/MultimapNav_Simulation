<?xml version="1.0" encoding="utf-8"?>
<robot name="clearing_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Migrated from robot_description/urdf/whc_description_gazebo.xacro.
       Joint layout matches the original: ten wheels plus joint1..joint7.
       arm_controller holds those seven joints at the URDF zero pose. -->

  <xacro:include filename="$(find multimap_nav_simulation)/robot/sensors/lidar_3d.xacro"/>
  <!-- A moderate scan rate keeps the original five side sensors affordable. -->
  <xacro:property name="lidar_hz" value="10.0"/>
  <xacro:property name="lidar_samples" value="720"/>
  <xacro:property name="lidar_max_range" value="30.0"/>


  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Simulation inertias use a uniform-density convex-hull approximation
       of each supplied STL at its original mass. The source CAD tensors were
       up to two orders of magnitude too small for these tonne-scale bodies.
       Wheel tensors use the exact solid-cylinder dimensions. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0110947986 0.0314803963 0.598827115" rpy="0 0 0"/>
      <mass value="13000"/>
      <inertia ixx="12116.6164" ixy="-0.0945527211" ixz="-24.048698"
               iyy="23395.8661" iyz="8.93522898" izz="32244.8535"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find multimap_nav_simulation)/meshes/clearing_robot/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <!-- The visual STL includes rigid track strips down to z=0. They must
         not act as skid plates: the ten drive wheels provide ground contact.
         Raised chassis proxies preserve the obstacle envelope above them. -->
    <collision name="chassis_collision">
      <origin xyz="0.004 0.0325 0.75" rpy="0 0 0"/>
      <geometry><box size="4.95 3.19 0.90"/></geometry>
    </collision>

  </link>

  <link name="left_wheel_back">
    <inertial>
      <mass value="500.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="32.55" ixy="0.0" ixz="0.0"
               iyy="57.6" iyz="0.0"
               izz="32.55"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.48"/>
      </geometry>
      <material name="">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.3" radius="0.48"/>
      </geometry>
    </collision>
  </link>

