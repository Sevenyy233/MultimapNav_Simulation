    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="link7">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="right_wheel_back">
    <material>Gazebo/Grey</material>
    <!-- The collision cylinder is rotated about X; its local Z is the wheel axle.
         Low axial/lateral friction allows the ten wheels to skid-steer.
         Bounded penetration correction avoids impulses from the mesh floor. -->
    <fdir1>0 0 1</fdir1>
    <mu1>0.05</mu1>
    <mu2>2.0</mu2>
    <slip1>0.2</slip1>
    <slip2>0.0</slip2>
    <kp>10000000.0</kp>
    <kd>10000.0</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
    <maxContacts>8</maxContacts>
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

  <gazebo reference="right_wheel_middle">
