  <!-- 机械臂部分 -->
  <link name="link1">
    <inertial>
      <origin xyz="-0.26630551 -2.46152979e-17 -0.555507403" rpy="0 0 0"/>
      <mass value="6000"/>
      <inertia ixx="3404.00724" ixy="0" ixz="-689.206256"
               iyy="11159.2513" iyz="0" izz="13988.6592"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find multimap_nav_simulation)/meshes/clearing_robot/PingTai.STL" />
      </geometry>
      <material name="">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <!-- STL collisions crash gzserver in ODE ray-sensor checks. The box is
         narrower than the mesh (y +-1.4) so the rslidar_* origins stay outside. -->
    <collision>
      <origin xyz="-0.675 0 -0.357" rpy="0 0 0" />
      <geometry><box size="4.95 2.3 1.013"/></geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 2.313" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="5" />
  </joint>

