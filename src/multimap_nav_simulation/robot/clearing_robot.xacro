  <xacro:macro name="arm_joint_transmission" params="name">
    <transmission name="${name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>
  <xacro:arm_joint_transmission name="joint1"/>
  <xacro:arm_joint_transmission name="joint2"/>
  <xacro:arm_joint_transmission name="joint3"/>
  <xacro:arm_joint_transmission name="joint4"/>
  <xacro:arm_joint_transmission name="joint5"/>
  <xacro:arm_joint_transmission name="joint6"/>
  <xacro:arm_joint_transmission name="joint7"/>

  <!-- ROS 2 控制系统 -->
  <ros2_control name="whc_control" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="left_wheel_back_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_wheel_middle_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_wheel_middle1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_wheel_middle2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_wheel_front_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_back_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_middle_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_middle1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <joint name="right_wheel_middle2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_front_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <xacro:macro name="arm_ros2_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:arm_ros2_joint name="joint1"/>
    <xacro:arm_ros2_joint name="joint2"/>
    <xacro:arm_ros2_joint name="joint3"/>
    <xacro:arm_ros2_joint name="joint4"/>
    <xacro:arm_ros2_joint name="joint5"/>
    <xacro:arm_ros2_joint name="joint6"/>
    <xacro:arm_ros2_joint name="joint7"/>
  </ros2_control>

  <!-- 为每个链接添加 Gazebo 材质定义 -->
  <gazebo reference="base_link">
    <kp>10000000.0</kp>
    <kd>10000.0</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
    <maxContacts>8</maxContacts>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="link1">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="link2">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="link3">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="link4">
    <material>Gazebo/Grey</material>
  </gazebo>

