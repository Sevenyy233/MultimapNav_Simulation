  <joint name="left_wheel_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_front"/>
    <origin xyz="2.0 1.4 0.47" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="2.0" friction="0.0"/>
    <!-- velocity limit is required by rqt_joint_trajectory_controller's URDF parser -->
    <limit effort="100" velocity="10"/>
  </joint>

  <joint name="left_wheel_middle_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_middle"/>
