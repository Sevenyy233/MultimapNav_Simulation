<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Nominal geometry/rate; 200 rays per 1 ms update, 100 ms packets.
       The CSV specifies direction order, not hardware channel IDs or time. -->
  <xacro:macro name="mid360_timed" params="parent xyz rpy noise_seed:=0">
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/><child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="lidar_link">
      <inertial>
        <mass value="0.265"/><origin xyz="0 0 0"/>
        <inertia ixx="${0.265*(0.065**2+0.060**2)/12}" ixy="0" ixz="0"
                 iyy="${0.265*(0.065**2+0.060**2)/12}" iyz="0"
                 izz="${0.265*(2*0.065**2)/12}"/>
      </inertial>
      <visual><geometry><box size="0.065 0.065 0.060"/></geometry>
        <material name="mid360_white"><color rgba="0.9 0.9 0.9 1"/></material>
      </visual>
      <collision><geometry><box size="0.065 0.065 0.060"/></geometry></collision>
    </link>
    <gazebo reference="lidar_link">
      <sensor name="lidar_link" type="ray">
        <always_on>true</always_on><visualize>false</visualize>
        <update_rate>1000</update_rate>
        <plugin name="mid360_timed" filename="libmultimap_mid360.so">
          <ray>
            <scan>
              <horizontal><samples>200</samples><resolution>1</resolution>
                <min_angle>0</min_angle><max_angle>${2*pi}</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution>
                <min_angle>${-7*pi/180}</min_angle><max_angle>${52*pi/180}</max_angle></vertical>
            </scan>
            <range><min>0.1</min><max>40.0</max><resolution>0.002</resolution></range>
          </ray>
          <visualize>false</visualize><samples>200</samples><downsample>1</downsample>
          <csv_file_name>$(find ros2_livox_simulation)/scan_mode/mid360.csv</csv_file_name>
          <topic>/livox/lidar</topic>
          <time_resolved>true</time_resolved><frame_duration>0.1</frame_duration>
          <range_noise_stddev>0.02</range_noise_stddev><noise_seed>${noise_seed}</noise_seed>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
