Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
    Background Color: 50; 53; 58
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Initial IMU plane
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated FAST-LIO map
      Enabled: true
      Topic:
        Value: /Laser_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Size (m): 0.08
      Color Transformer: FlatColor
      Color: 100; 210; 240
    - Class: rviz_default_plugins/PointCloud2
      Name: Current registered scan
      Enabled: true
      Topic:
        Value: /cloud_registered
        Reliability Policy: Reliable
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 240; 240; 240
    - Class: rviz_default_plugins/MarkerArray
      Name: Stowed robot envelope
      Enabled: true
      Topic:
        Value: /clearing/collision_model
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: FAST-LIO path
      Enabled: true
      Topic:
        Value: /path
        Reliability Policy: Reliable
      Color: 255; 170; 40
      Line Width: 0.06
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Pitch: 0.7
      Yaw: 0.7
      Target Frame: map
Window Geometry:
  Width: 1440
  Height: 960
