<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 行进受整车包络及曲率约束，障碍出现时由统一局部控制器停车或绕行。 -->
    <GoalLoop goal="{goal}" base_frame="{base_frame}"
              goal_position_tolerance="{goal_position_tolerance}"
              goal_yaw_tolerance="{goal_yaw_tolerance}"
              goal_height_tolerance="{goal_height_tolerance}"
              goal_require_stopped="{goal_require_stopped}"
              goal_odom_topic="{goal_odom_topic}"
              goal_stop_linear_velocity="{goal_stop_linear_velocity}"
              goal_stop_angular_velocity="{goal_stop_angular_velocity}"
              goal_stable_duration="{goal_stable_duration}">
      <Sequence>
        <ComputePathToPose goal="{goal}" global_path="{global_path}" server_name="compute_path_to_pose"/>
        <LocalControl global_path="{global_path}" server_name="local_control"/>
      </Sequence>
    </GoalLoop>
  </BehaviorTree>
</root>
